#!/bin/bash
#PBS -N sims_misid
#PBS -J 1-60%25
#PBS -l select=1:ncpus=1:mem=8gb
#PBS -l walltime=24:00:00
#PBS -o /home/projects/ssi_gen1/people/dalmiz/Sample_Misassignment_0826/MISID_QC/simulations/logs/sims_misid_%J_%I.out
#PBS -e /home/projects/ssi_gen1/people/dalmiz/Sample_Misassignment_0826/MISID_QC/simulations/logs/sims_misid_%J_%I.err
#PBS -V

# Submit with: qsub simulations/run_sims.pbs
# simulations/logs must already exist before submission.
# Afterwards: Rscript simulations/Run_across_simulated_data.R combine=TRUE

set -euo pipefail
module load r/4.5.1

cd /home/projects/ssi_gen1/people/dalmiz/Sample_Misassignment_0826/MISID_QC
export N_TASKS=60
export OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1

# Compare detection modes with: RUN_ARGS='cv_folds=5 detect_unknown=TRUE,FALSE' qsub simulations/run_sims.pbs
# RUN_ARGS replaces the default entirely.
RUN_ARGS="${RUN_ARGS:-cv_folds=5}"
TASK_ID="${PBS_ARRAY_INDEX:-${PBS_ARRAYID:-1}}"

# shellcheck disable=SC2086
Rscript simulations/Run_across_simulated_data.R \
  task_id="${TASK_ID}" n_tasks="${N_TASKS}" ${RUN_ARGS}
